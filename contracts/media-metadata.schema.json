{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "media-metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "width",
    "height",
    "fps_num",
    "fps_den",
    "frame_count",
    "duration_seconds",
    "has_audio",
    "rotation",
    "validation_profile"
  ],
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "fps_num": {
      "type": "integer",
      "minimum": 1
    },
    "fps_den": {
      "type": "integer",
      "minimum": 1
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "has_audio": {
      "type": "boolean"
    },
    "rotation": {
      "const": 0
    },
    "validation_profile": {
      "const": "cpu-cfr-v1"
    }
  }
}
