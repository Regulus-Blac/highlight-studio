{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "export_id",
    "task_id",
    "plan_id",
    "engine",
    "mock",
    "format",
    "status",
    "artifact",
    "error",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "export_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engine": {
      "type": "string"
    },
    "mock": {
      "type": "boolean"
    },
    "format": {
      "enum": [
        "mp4",
        "jsonl"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed"
      ]
    },
    "artifact": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "size_bytes",
            "sha256",
            "output",
            "duration_seconds"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "output": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "width",
                    "height"
                  ],
                  "properties": {
                    "width": {
                      "type": "integer",
                      "minimum": 2,
                      "multipleOf": 2
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 2,
                      "multipleOf": 2
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "duration_seconds": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "artifact": {
            "type": "object"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "artifact": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    }
  ]
}
