{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "rules_version",
    "video_id",
    "target_ratio",
    "engine",
    "mock",
    "metadata",
    "suggestions",
    "segments",
    "frame_crops",
    "output",
    "duration_seconds",
    "plan_id",
    "source_sha256",
    "source_url"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "rules_version": {
      "const": "consecutive-inward-v1"
    },
    "video_id": {
      "type": "string"
    },
    "target_ratio": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "engine": {
      "type": "string"
    },
    "mock": {
      "type": "boolean"
    },
    "metadata": {
      "$ref": "media-metadata.schema.json"
    },
    "suggestions": {
      "type": "array",
      "items": {
        "$ref": "segment.schema.json"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "segment.schema.json"
      }
    },
    "frame_crops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame",
          "crop"
        ],
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "crop": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 2
              },
              {
                "type": "integer",
                "minimum": 2
              }
            ]
          }
        }
      }
    },
    "output": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 2,
              "multipleOf": 2
            },
            "height": {
              "type": "integer",
              "minimum": 2,
              "multipleOf": 2
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_url": {
      "type": "string"
    }
  }
}
