{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional SSH demo deployment descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["location", "mode", "transport"],
  "properties": {
    "location": {"const": "remote"},
    "mode": {"enum": ["mock", "real"]},
    "transport": {"const": "ssh"}
  }
}
